.venv/
.venv-*/
.deps/
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
*.log
*.lock
*.partial

# Historical data, results, manuscripts, checkpoints and private keys. Local only.
/trash/
.checkpoints/

# Original recordings and generated results are distributed as research artifacts,
# not silently committed as large Git files. Metadata and empty destinations stay visible.
/data/*.jsonl
/data/*.beast
/data/*.beast.json
/results/daytime/*
!/results/daytime/.gitkeep
/results/nighttime/*
!/results/nighttime/.gitkeep
/results/comparison/*
!/results/comparison/.gitkeep
