# Keep source/config bytes stable for scientific provenance across checkouts.
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
# Preserve captured inputs and integrity-checked tabular outputs byte-for-byte.
*.jsonl -text
*.csv -text
*.pdf binary
*.png binary
